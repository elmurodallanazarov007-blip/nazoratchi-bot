# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=123456789:AAExampleTokenHere

# MongoDB Atlas connection string (Atlas "Connect" -> "Drivers" bo'limidan olinadi)
# Parolni <password> o'rniga haqiqiy parol bilan almashtiring, va parolda maxsus
# belgilar bo'lsa (@ : / # % va h.k.) URL-encode qiling.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Baza nomi (Atlas'da avtomatik yaratiladi, xohlagan nom qo'yishingiz mumkin)
MONGODB_DB_NAME=nazoratchi

# Majburiy kanallar endi index.js faylining yuqori qismida (CHANNELS massivi)
# to'g'ridan-to'g'ri kodda belgilangan — bu yerda sozlash shart emas.
# Kanal qo'shish/o'chirish uchun index.js dagi CHANNELS massivini tahrirlang,
# yoki bot ishga tushgach admin buyruqlaridan foydalaning:
#   /addchannel @kanal https://t.me/kanal
#   /removechannel @kanal
#   /listchannels

# Admin(lar) Telegram user_id lari, vergul bilan ajratilgan
ADMIN_IDS=111111111,222222222

# Render kabi platformalarda webhook uchun (ixtiyoriy).
# Boʻsh qoldirilsa bot "polling" rejimida ishlaydi (eng oddiy usul).
# Toʻldirilsa, "webhook" rejimida ishlaydi (masalan https://your-app.onrender.com)
WEBHOOK_URL=
PORT=3000
